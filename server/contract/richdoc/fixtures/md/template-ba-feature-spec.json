                            {
                              "type": "bold"
                            }
                          ],
                          "text": "then"
                        },
                        {
                          "type": "text",
                          "text": " <what the user sees or gets>."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "attrs": {
                    "blockId": "b-00000f"
                  },
                  "content": [
                    {
