              },
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Acceptance scenarios:"
                }
              ]
            },
            {
              "type": "orderedList",
              "attrs": {
                "blockId": "b-00000c"
              },
              "content": [
                {
                  "type": "listItem",
                  "attrs": {
