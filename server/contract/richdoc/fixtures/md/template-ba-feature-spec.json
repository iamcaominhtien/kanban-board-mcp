{
  "type": "doc",
  "content": [
    {
      "type": "heading",
      "attrs": {
        "blockId": "b-000001",
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Summary"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "blockId": "b-000002"
      },
      "content": [
        {
          "type": "text",
          "text": "One or two sentences: who gets what, and why it matters now. Link the ticket ("
        },
        {
          "type": "ticketRef",
          "attrs": {
            "key": "KAN-12"
          }
        },
        {
          "type": "text",
          "text": ") and any Story."
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "blockId": "b-000003",
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "User stories"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "blockId": "b-000004"
      },
      "content": [
        {
          "type": "text",
          "text": "Ordered by priority. Each one can be built and tested on its own: P1 alone is already worth shipping."
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "blockId": "b-000005",
        "level": 3
      },
      "content": [
        {
          "type": "text",
          "text": "P1 · "
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "blockId": "b-000006"
      },
      "content": [
        {
          "type": "text",
          "text": "As a <who>, I want <what>, so that <why>."
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "blockId": "b-000007"
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "blockId": "b-000008"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "blockId": "b-000009"
              },
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Test on its own:"
                },
                {
                  "type": "text",
                  "text": " how a tester sees that this story works, without the others."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "blockId": "b-00000a"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
