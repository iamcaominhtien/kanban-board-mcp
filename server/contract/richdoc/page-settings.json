{
  "note": "Per-page settings (docs_page.settings, JSON). Every key is optional; a missing key is its default. They belong to the page, not to a person. Reader preferences (text size, theme, justify, sans) are kept on the device, not here.",
  "keys": {
    "width": {
      "default": "normal",
      "values": [
        "narrow",
        "normal",
        "wide",
        "full"
      ],
      "px": {
        "narrow": 560,
        "normal": 680,
        "wide": 880,
        "full": null
      }
    },
    "background": {
      "default": "white",
      "values": [
        "white",
        "paper",
        "mist",
        "sepia",
        "night"
      ]
    },
    "bodyFont": {
      "default": "jakarta",
      "values": [
        "jakarta",
        "lora",
        "source-serif",
        "merriweather",
        "playfair",
        "inter",
        "jetbrains-mono",
        "caveat"
      ]
    },
    "headingFont": {
      "default": null,
      "note": "null = the body font",
      "values": [
        null,
        "jakarta",
        "lora",
        "source-serif",
        "merriweather",
        "playfair",
        "inter",
        "jetbrains-mono",
        "caveat"
      ]
    },
    "textSize": {
      "default": "m",
      "values": [
        "s",
        "m",
        "l"
      ]
    },
    "lineHeight": {
      "default": 1.6,
      "values": [
        1.4,
        1.6,
        1.8,
        2.0
      ]
    },
    "showOutline": {
      "default": true,
      "values": [
        true,
        false
      ]
    },
    "cover": {
      "default": null,
      "shape": {
        "src": "string",
        "positionY": "number 0..100",
        "height": "s|m|l",
        "titleOnCover": "boolean"
      }
    },
    "icon": {
      "default": null,
      "note": "an emoji, an icon name (icon:<name>) or an uploaded image (/uploads/...)"
    },
    "titleStyle": {
      "default": "plain",
      "values": [
        "plain",
        "serif",
        "display",
        "eyebrow"
      ]
    },
    "titleAlign": {
      "default": "left",
      "values": [
        "left",
        "center"
      ]
    },
    "eyebrow": {
      "default": null,
      "note": "the small line above the title (ENGINEERING NOTES)"
    },
    "showByline": {
      "default": true,
      "values": [
        true,
        false
      ]
    },
    "showReadingTime": {
      "default": true,
      "values": [
        true,
        false
      ]
    },
    "highlights": {
      "default": "comment",
      "values": [
        "comment",
        "off"
      ],
      "note": "people who can comment can highlight / off for this page"
    },
    "notForAi": {
      "default": false,
      "values": [
        true,
        false
      ]
    },
    "aiApply": {
      "default": null,
      "values": [
        null,
        "suggest",
        "direct"
      ],
      "note": "null = the team setting; the page wins over the team"
    },
    "book": {
      "default": null,
      "shape": {
        "isBook": "boolean",
        "numberChapters": "boolean"
      }
    },
    "status": {
      "default": null,
      "values": [
        null,
        "draft",
        "in-review",
        "final",
        "outdated"
      ]
    },
    "reviewedAt": {
      "default": null,
      "note": "ISO time of Mark as reviewed"
    },
    "lockedBlocks": {
      "default": [],
      "note": "top-level block ids AI teams may not change (\"Teams cannot change this\"); at most 500"
    }
  }
}
