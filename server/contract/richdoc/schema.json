        "border": {
          "default": null,
          "type": "string|null",
          "note": "the sides that have a line: \"top right bottom left\" (any of them) or \"none\"; null: as the table draws it"
        },
        "borderStyle": {
          "default": null,
          "type": "enum",
          "values": [
            null,
            "thick",
            "dashed"
          ],
          "note": "null: 1 px solid"
        },
        "borderColor": {
          "default": null,
          "type": "string|null",
          "note": "colour name from palette.json or #rrggbb"
        },
        "padding": {
          "default": null,
          "type": "enum",
          "values": [
            null,
            "tight",
            "roomy"
          ]
        }
      }
    },
    "tableHeader": {
      "content": "block+",
      "attrs": "same as tableCell"
    },
    "image": {
