{
  "formatVersion": 1,
  "blockIdPattern": "^b-[0-9a-f]{6}$",
  "topLevelParents": [
    "doc",
    "column"
  ],
  "nodes": {
    "doc": {
      "content": "block+"
    },
    "paragraph": {
      "group": "block",
      "content": "inline*",
      "attrs": {
        "blockId": {
          "default": null,
          "type": "string|null",
          "note": "b-xxxxxx"
        },
        "textAlign": {
          "default": null,
          "type": "enum",
          "values": [
            null,
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "indent": {
          "default": 0,
          "type": "number",
          "min": 0,
          "max": 8
        },
        "lineHeight": {
          "default": null,
          "type": "number|null",
          "note": "1, 1.15, 1.5 or 2"
        },
        "spaceBefore": {
          "default": null,
          "type": "number|null",
          "note": "px"
        },
        "spaceAfter": {
          "default": null,
          "type": "number|null",
          "note": "px"
        },
        "dropCap": {
          "default": 0,
          "type": "enum",
          "values": [
            0,
            2,
            3,
            4,
            5
          ]
        },
        "variant": {
          "default": null,
          "type": "enum",
          "values": [
            null,
            "lead",
            "small"
          ]
        },
        "dropCapStyle": {
          "default": null,
          "type": "enum",
          "values": [
            null,
            "raised"
          ],
          "note": "null: dropped into the text; raised: standing on the first line"
        },
        "dropCapColor": {
          "default": null,
          "type": "string|null",
          "note": "colour name from palette.json or #rrggbb; null: the text colour"
        },
        "dropCapFont": {
          "default": null,
          "type": "enum",
          "values": [
            null,
            "body"
          ],
          "note": "null: the heading font"
        }
      }
    },
    "heading": {
      "group": "block",
      "content": "inline*",
      "attrs": {
        "blockId": {
          "default": null,
          "type": "string|null",
          "note": "b-xxxxxx"
        },
        "level": {
          "default": 1,
          "type": "enum",
          "values": [
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        "textAlign": {
          "default": null,
          "type": "enum",
          "values": [
            null,
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "indent": {
          "default": 0,
          "type": "number",
          "min": 0,
          "max": 8
        },
        "lineHeight": {
          "default": null,
          "type": "number|null",
          "note": "1, 1.15, 1.5 or 2"
        },
        "spaceBefore": {
          "default": null,
          "type": "number|null",
          "note": "px"
        },
        "spaceAfter": {
          "default": null,
          "type": "number|null",
          "note": "px"
        }
      }
    },
    "blockquote": {
      "group": "block",
      "content": "block+",
      "attrs": {
        "blockId": {
          "default": null,
          "type": "string|null",
          "note": "b-xxxxxx"
        },
        "variant": {
          "default": "plain",
          "type": "enum",
          "values": [
            "plain",
            "serif",
            "card"
