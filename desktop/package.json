{
  "name": "kanban-board-desktop",
  "version": "3.26.0",
  "description": "Kanban Board MCP Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_DEV=1 electron .",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info tests/*.test.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1",
    "sharp": "^0.33.5",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.kanbanboard.app",
    "productName": "Kanban Board",
    "directories": {
      "buildResources": "build",
      "output": "../dist-desktop"
    },
    "files": [
      "main.js",
      "main-helpers.js",
      "menu.js",
      "updater.js",
      "updater-helpers.js",
      "preload.js",
      "vscode-setup.js",
      "export-svg.js",
      "notifier.js",
      "sounds.js"
    ],
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui/dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../dist-drawio",
        "to": "drawio"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "../dist-python/kanban-mcp-stdio",
          "to": "kanban-mcp-stdio"
        }
      ],
      "electronLanguages": [
        "en",
        "en_FEMININE",
        "en_MASCULINE",
        "en_NEUTER",
        "en_GB",
        "en_GB_FEMININE",
        "en_GB_MASCULINE",
        "en_GB_NEUTER",
        "vi",
        "vi_FEMININE",
        "vi_MASCULINE",
        "vi_NEUTER"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../dist-python/kanban-mcp-stdio",
          "to": "kanban-mcp-stdio"
        }
      ],
      "electronLanguages": [
        "en-US",
        "en-GB",
        "vi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
